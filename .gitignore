# Ignore large raw image datasets (downloaded separately)
dataset/
NEU-DET/
severstal dataset/

# Ignore large binary model weights (>100MB exceeds GitHub limits)
outputs/weights/
*.pth
*.pt
*.onnx
*.h5
*.hdf5
*.keras

# Ignore temporary heatmap overlays generated during runtime
outputs/heatmaps/

# FAISS Vector Index & SQLite Local Caches
data/docs/faiss_index/
data/reports_log.db
data/docs/raw/

# Python patterns
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
env/
.venv/
venv/
ENV/
build/
dist/
*.egg-info/
*.log

# Node / TypeScript (Server) patterns
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
server/node_modules/
server/src/widgets/node_modules/
server/dist/
server/src/widgets/.next/
server/src/widgets/out/
server/coverage/
server/.eslintcache
server/*.tsbuildinfo

# IDEs & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Environment & Secrets (Security)
.env
.env.*
*.env

